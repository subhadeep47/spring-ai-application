# ==========================================
# 1. ROOT & COMMON IGNORES
# ==========================================
# OS generated files
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak

# IDE & Editor Directories (Global)
.idea
*.iws
*.iml
*.ipr
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Global Log files
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# NetBeans specific (Global overrides)
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ==========================================
# 2. FRONTEND (React + Vite + TypeScript)
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/*.tsbuildinfo

# ==========================================
# 3. BACKEND (Java + Maven + Spring Boot)
# ==========================================
backend/HELP.md
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
!backend/**/src/main/**/target/
!backend/**/src/test/**/target/

# Local environmental properties
backend/src/main/resources/application-local.properties
